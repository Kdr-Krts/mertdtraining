      sizes="100vw"
      width="2752"
      height="1536"
      alt=""
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="hero-brand">{{ site.brand }}</p>
        <h1>Doğru plan,<br /><span>sürdürülebilir</span><br />gelişim.</h1>
        <p class="hero-lead">Yağ kaybı, kas kazanımı veya sportif performans — başlangıç noktanı belirleyerek sana uygun sistemi birlikte oluşturuyoruz.</p>
        <div class="hero-cta">
          <a href="/egitimler/" class="btn btn-primary">Paketleri İncele</a>
          <a href="/plan-formu/" class="btn btn-ghost">Doğru plan için formu doldur</a>
        </div>
      </div>
      <ul class="feature-labels" aria-label="Hizmet alanları">
        <li>
          <strong>Atletik <br />Performans</strong>
          <span>Daha güçlü, daha hazır.</span>
        </li>
        <li>
          <strong>Kondisyon &amp; <br />Dayanıklılık</strong>
          <span>Enerjini artır, sınırlarını zorla.</span>
        </li>
        <li>
          <strong>Beslenme <br />Desteği</strong>
          <span>Doğru beslen, verimini artır.</span>
        </li>
        <li>
          <strong>Online <br />Koçluk</strong>
          <span>Her yerden, kesintisiz destek.</span>
        </li>
        <li>
          <strong>Kişiye Özel <br />Programlar</strong>
          <span>Hedefine uygun, sana özel plan.</span>
        </li>
      </ul>
